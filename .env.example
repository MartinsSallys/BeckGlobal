APP_NAME=Backend Boilerplate
DEBUG=False

# Execução local (PostgreSQL rodando na máquina):
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/beckglobal

SECRET_KEY=change-me-to-a-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["*"]

# Notas:
# - Dentro do Docker Compose o DATABASE_URL é sobrescrito para o host "db"
#   (veja docker-compose.yml), então não precisa alterar aqui.
# - Gere uma SECRET_KEY forte com: openssl rand -hex 32
